{
  "name": "Asus AI Hub",
  "productName": "Asus AI Hub",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --exec electron ."
  },
  "build": {
    "appId": "com.5xruby.asus-ai-hub",
    "productName": "Asus AI Hub",
    "directories": {
