    "win": {
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^26.2.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.14"
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "nodemon": "^3.1.10",
    "systeminformation": "^5.27.11",
    "unzipper": "^0.12.3"
  }
}
